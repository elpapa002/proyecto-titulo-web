# Copiar este archivo como .env (en esta misma carpeta) y poner la clave real de PostgreSQL.
# El .env no se sube a GitHub (esta en el .gitignore). appsettings.Example.json muestra los mismos datos en formato json.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=compraventa;Username=compraventa_app;Password=CAMBIAR
# Frase larga y secreta para firmar los tokens de sesion. Si se omite, se crea una al azar cada vez que parte el backend.
# Auth__Secreto=CAMBIAR_POR_UNA_FRASE_LARGA_Y_ALEATORIA
# Porcentaje con que se reajusta cada semana una cotizacion expirada (si se omite, 2).
# Cotizaciones__ReajusteSemanal=2
# Paginas que pueden llamar a la API desde otro computador (CORS). Por defecto http://localhost:5173 y http://127.0.0.1:5173.
# Cors__Origenes__0=http://localhost:5173
# Cors__Origenes__1=http://192.168.100.20:5173
